{
  "name": "fast-cucumber-java-runner",
  "displayName": "Fast Cucumber Java Runner",
  "publisher": "ksanjeev9211",
  "version": "0.0.2",
  "repository": {
    "type": "git",
    "url": "https://github.com/ksanjeev9211/fast-cucumber-java-runner.git"
  },
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Testing"
  ],
  "activationEvents": [
    "onLanguage:gherkin",
    "onLanguage:feature",
    "onCommand:fastCucumber.runScenario",
    "onCommand:fastCucumber.debugScenario",
    "onCommand:fastCucumber.runAllScenarios",
    "onCommand:fastCucumber.debugAllScenarios",
    "onCommand:fastCucumber.showLogs"
  ],
  "extensionDependencies": [
    "redhat.java",
    "vscjava.vscode-java-debug"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configurationDefaults": {
      "editor.codeLens": true,
      "testing.gutterEnabled": true
    },
    "languages": [
      {
        "id": "gherkin",
        "aliases": [
          "Gherkin",
          "cucumber",
          "feature"
        ],
        "extensions": [
          ".feature"
        ]
      }
    ],
    "commands": [
      {
        "command": "fastCucumber.runScenario",
        "title": "Fast Cucumber: Run Scenario"
      },
      {
        "command": "fastCucumber.debugScenario",
        "title": "Fast Cucumber: Debug Scenario"
      },
      {
        "command": "fastCucumber.runAllScenarios",
        "title": "Fast Cucumber: Run All Scenarios"
      },
      {
        "command": "fastCucumber.debugAllScenarios",
        "title": "Fast Cucumber: Debug All Scenarios"
      },
      {
        "command": "fastCucumber.showLogs",
        "title": "Fast Cucumber: Show Diagnostic Logs"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.3"
  }
}
